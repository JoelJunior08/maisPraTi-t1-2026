# Modelo do arquivo .env. Copie para ".env" e preencha.
# O .env real NUNCA vai para o Git (está no .gitignore e no .dockerignore).
# Ele é lido por: docker compose (env_file) e pelo Spring rodando no IntelliJ
# (spring.config.import no application.properties).
#
# Em produção (Railway), estas MESMAS chaves são cadastradas na aba
# "Variables" do serviço — lá não existe arquivo .env.

# Stripe → Dashboard > Developers > API keys (modo teste: sk_test_...)
STRIPE_SECRET_KEY=
# Stripe → Developers > Webhooks > (seu endpoint) > Signing secret (whsec_...)
# Localmente, é o segredo que o `stripe listen` imprime.
STRIPE_WEBHOOK_SECRET=

# Em produção, gere um valor forte: openssl rand -base64 48
JWT_SECRET=

# Opcionais (têm padrão para desenvolvimento no application.properties):
# GOOGLE_CLIENT_ID=
# FRONT_URL=http://localhost:5173
# CORS_ORIGENS=http://localhost:5173
# SHOW_SQL=true
